// ============ SOCIAL INSIGHTS ============

model LinkMetric {
  id String @id @default(uuid())

  // Nullable FK — survives ReportLink delete-and-recreate on resubmit (SetNull).
  // Re-heal query in cron re-links orphaned snapshots to new ReportLink rows.
  linkId String? @map("link_id")

  // Denormalised so analytics work even when linkId is null
  employeeId    String   @map("employee_id")
  reportDate    DateTime @map("report_date") @db.Date
  url           String
  urlNormalized String   @map("url_normalized")
  platform      String
  videoId       String?  @map("video_id")

  // Snapshot values
  fetchedAt    DateTime @default(now()) @map("fetched_at")
  status       String // "ok" | "not_found" | "private" | "error"
  views        Int?
  likes        Int?
  comments     Int?
  shares       Int?
  errorMessage String?  @map("error_message")

  link     ReportLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  employee User        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, reportDate])
  @@index([urlNormalized])
  @@index([linkId])
  @@index([platform, fetchedAt])
  // Plain (employeeId, urlNormalized, fetchedAt DESC) index for the leaderboard/insights
  // latest-per-(employee,url) DISTINCT ON lookup. Prisma's schema DSL cannot express a
  // partial (WHERE status='ok') or covering (INCLUDE views/likes/comments/reportDate)
  // index, so this plain version is what a fresh/local database gets. The TUNED
  // partial+covering index (prod-measured 2790ms → 763ms) is built manually on
  // production via raw SQL (CREATE INDEX CONCURRENTLY ... INCLUDE (...) WHERE
  // status='ok') in a later task. Do NOT drop this entry.
  @@index([employeeId, urlNormalized, fetchedAt(sort: Desc)])
  @@map("link_metrics")
}

// ============ LINK ENTITY SEARCH ============
// Additive-only feature (CREATE TABLE only — no ALTER/DROP on existing tables).
// LinkContent has NO FK to ReportLink: the join is by canonicalKey() computed on
// read (same philosophy as link dedupe — raw URLs stay in report_links, the key
// is derived). Survives the report_links delete-and-recreate churn with zero re-linking.

model Entity {
  id            String   @id @default(uuid())
  canonicalName String // "Salman Khan"
  type          String   @default("PERSON") // PERSON | TOPIC | BRAND | OTHER
  aliases       String[] // ["bhaijaan","sallu","beingsalmankhan","सलमान"] — stored LOWERCASE
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  links LinkContentEntity[]

  @@unique([canonicalName])
  @@index([type])
  @@map("entities")
}

model LinkContent {
  id           String    @id @default(uuid())
  canonicalKey String // ig:CxYz / yt:dQw4 / fb:123 / full-url fallback
  platform     String // classified by URL, not the dirty platform column
  title        String?   @db.Text // YouTube title
  caption      String?   @db.Text // IG/FB caption (and YouTube description)
  status       String    @default("pending") // pending | ok | not_found | private | unsupported | error
  extractedAt  DateTime? @map("extracted_at") // null until stage 2 runs; set when entities extracted
  fetchedAt    DateTime? @map("fetched_at") // when caption/title last fetched
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  entities LinkContentEntity[]

  @@unique([canonicalKey])
  @@index([status])
  @@index([extractedAt])
  @@map("link_content")
}

model LinkContentEntity {
  id            String @id @default(uuid())
  linkContentId String @map("link_content_id")
  entityId      String @map("entity_id")
  confidence    Float  @default(1.0)

  content LinkContent @relation(fields: [linkContentId], references: [id], onDelete: Cascade)
  entity  Entity      @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([linkContentId, entityId])
  @@index([entityId])
  @@map("link_content_entities")
}

// API-usage ledger for the admin Cost Sheet. One row per billable API call (or
// batch). ADDITIVE + write-only from the app's perspective — nothing reads it on
// the hot path; the Cost Sheet aggregates it on demand. Logging is fail-open: a
// write failure here must NEVER affect the underlying API call.
//
// provider:   "openai" | "gemini" | "anthropic" | "meta" | "youtube"
// model:      model id (e.g. "gpt-4o-mini", "claude-haiku-4-5") or "" for non-LLM
// operation:  what the call did (e.g. "entity-extraction", "ai-generate",
//             "graph-business-discovery", "youtube-statistics") — for breakdowns
// calls:      number of API calls this row represents (usually 1; batched > 1)
// units:      provider-native billable units (Graph calls, YouTube quota units) —
//             null for token-billed LLMs
// inputTokens/outputTokens: LLM token counts — null for non-LLM
// costUsd:    computed cost in USD from the price table at write time (so a later
//             price change doesn't retroactively rewrite history). May be 0 when
//             the unit price is unknown — the call is still recorded (count != 0).
model ApiUsage {
  id           String   @id @default(uuid())
  provider     String
  model        String   @default("")
  operation    String   @default("")
  calls        Int      @default(1)
  units        Int?
  inputTokens  Int?     @map("input_tokens")
  outputTokens Int?     @map("output_tokens")
  costUsd      Float    @default(0) @map("cost_usd")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([provider, createdAt])
  @@index([createdAt])
  @@map("api_usage")
}

// ─────────────────────────────────────────────────────────────────────────────
// Meta OAuth — "Post Automation 2" (app 298449321694397)
//
// ⚠️ This is a DELIBERATE SIBLING of the older System-User integration, not a
// replacement. The legacy app (998903906094758 "Dashmani Insights", read via
// META_SYSTEM_USER_TOKEN) still powers Top Links / Link Search insights and is
// untouched by any of this. The two apps' credentials must NEVER be mixed —
// pairing one app's id with the other's secret fails with an opaque (#1).
//
// Provenance rule this subsystem enforces: a Meta follower/post number is either
// sourced from a CONNECTED asset below, or it is rendered as "—". There is no
// third source and no scraper fallback.
// ─────────────────────────────────────────────────────────────────────────────

/// One-time CSRF nonce that ALSO carries the admin-session binding.
///
/// ⚠️ WHY THIS TABLE EXISTS: this API has no cookies anywhere and auth tokens live
/// in localStorage, which a top-level redirect back from Meta cannot read. So this
/// row IS the only link between "the admin who started the flow" and "the browser
/// that came back". Consumed with updateMany({usedAt:null}) + a count check —
/// never a bare update()/delete(). That one-time-consume rule is the exact bug
/// that bit all three auth services (PR #101) and the admin invite flow (PR #108).
model MetaOAuthState {
  state        String    @id
  userId       String    @map("user_id")
  mode         String    @default("connect")
  connectionId String?   @map("connection_id")
  usedAt       DateTime? @map("used_at")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("meta_oauth_states")
}

model MetaConnection {
  id            String  @id @default(uuid())
  /// debug_token data.user_id — WHICH Facebook account granted this.
  metaUserId    String  @unique @map("meta_user_id")
  metaUserName  String? @map("meta_user_name")
  /// The internal admin who ran the flow, taken from the consumed state row.
  /// Restrict (not Cascade): archiving an employee must never silently delete a
  /// live Meta connection and orphan every asset hanging off it.
  connectedById String  @map("connected_by_id")

  /// enc:v1:… AES-256-GCM. Used ONLY to read /me/accounts and IG nodes.
  /// ⚠️ NEVER logged, NEVER written to AuditLog, NEVER in any API response.
  /// NULL once revoked.
  userTokenEnc String? @map("user_token_enc") @db.Text

  grantedScopes  String @default("") @map("granted_scopes")
  granularScopes Json?  @map("granular_scopes")

  /// debug_token expires_at; 0 ("never expires") is stored as NULL.
  tokenExpiresAt      DateTime? @map("token_expires_at")
  /// debug_token data_access_expires_at — the REAL ~90-day clock.
  /// ⚠️ NEVER compute this as now()+90d; always read it from debug_token.
  dataAccessExpiresAt DateTime? @map("data_access_expires_at")

  /// The Graph version this grant was established on. Recorded so a Meta
  /// auto-upgrade after a version sunset is diagnosable rather than mysterious.
  graphVersion String @default("v21.0") @map("graph_version")

  status MetaConnectionStatus @default(ACTIVE)

  /// pending | pages | ig_nodes | done — discovery is budgeted and RESUMABLE
  /// because a first pass over an 87-Page estate costs ~61 Graph calls.
  discoveryState  String  @default("pending") @map("discovery_state")
  discoveryCursor String? @map("discovery_cursor")

  /// Which read paths actually work, learned by live probe. Never holds secrets.
  capabilities Json?

  lastVerifiedAt DateTime? @map("last_verified_at")
  lastSyncedAt   DateTime? @map("last_synced_at")
  /// Secret-scrubbed before write; surfaced verbatim in the admin ops strip.
  lastError      String?   @map("last_error") @db.Text
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  connectedBy User        @relation("MetaConnectionsCreated", fields: [connectedById], references: [id], onDelete: Restrict)
  assets      MetaAsset[]

  @@index([status])
  @@map("meta_connections")
}

enum MetaConnectionStatus {
  ACTIVE
  PARTIAL_SCOPE
  NEEDS_REAUTH_SOON
  NEEDS_REAUTH
  RATE_LIMITED
  REVOKED
}

model MetaAsset {
  id            String        @id @default(uuid())
  connectionId  String        @map("connection_id")
  kind          MetaAssetKind
  /// FB Page id, or IG Business account id. Meta-assigned and stable.
  metaId        String        @map("meta_id")
  name          String
  username      String?
  /// IG only: the Page it hangs off. IG assets carry NO token of their own, so
  /// the same Page secret is never written into two rows.
  parentPageId  String?       @map("parent_page_id")
  /// FACEBOOK_PAGE only. enc:v1:… Page token, which arrives inline on
  /// /me/accounts — there is NO separate mint call (facebook.provider.ts's
  /// header comment saying otherwise is stale and costs a wasted call per Page).
  pageTokenEnc  String?       @map("page_token_enc") @db.Text
  tasks         String[]      @default([])
  followerCount Int?          @map("follower_count")
  postCount     Int?          @map("post_count")
  pictureUrl    String?       @map("picture_url")

  /// Soft link into the channel registry. Nullable + SetNull: an asset is
  /// perfectly valid with no match, and archiving a channel must never cascade
  /// into deleting a live connection.
  socialAccountId String? @map("social_account_id")

  selected Boolean @default(true)

  /// Which read path + which insight metric names work FOR THIS ASSET, keyed by
  /// post class (IG: media_product_type; FB: video|other).
  /// ⚠️ Keyed PER POST CLASS, not per connection: one invalid metric 400s the
  /// entire /insights call, and the valid set genuinely differs between
  /// REELS / FEED / IMAGE / CAROUSEL.
  metricCapabilities Json? @map("metric_capabilities")

  // ── CHANNEL-LEVEL METRICS (the primary thing Account Growth renders) ──────
  //
  // The page is a CHANNEL monitor, not a post feed: an admin wants "how is each
  // Page/IG account doing", not 10,000 individual posts. These are whole-account
  // figures from the page/account insights edges, refreshed per run.
  //
  // ⚠️ All nullable and rendered as "—" when absent. Metric availability differs
  // per platform and per account, and a fabricated 0 would read as a real result.
  // Live-probed 2026-08-24 on v21.0; dead names are listed in the service.
  /// FB page_video_views | IG views. Whole-account, last 28d.
  views28d         BigInt?   @map("views_28d")
  /// FB page_post_engagements | IG total_interactions. Last 28d.
  engagements28d   BigInt?   @map("engagements_28d")
  /// FB page_views_total | IG profile_views. Last 28d.
  profileViews28d  BigInt?   @map("profile_views_28d")
  /// IG only (FB publishes no comparable unique-reach metric). Last 28d.
  reach28d         BigInt?   @map("reach_28d")
  /// FB page_actions_post_reactions_total summed | IG likes. Last 28d.
  reactions28d     BigInt?   @map("reactions_28d")
  /// When the channel-level metrics above were last refreshed.
  metricsFetchedAt DateTime? @map("metrics_fetched_at")
  /// Why the last channel-metrics fetch failed, if it did (secret-scrubbed).
  metricsError     String?   @map("metrics_error")

  /// When demographics were last ATTEMPTED for this asset — not when rows landed.
  ///
  /// ⚠️ Rotation must key on the ATTEMPT, not on the child rows. Meta withholds
  /// demographics entirely for accounts below its privacy threshold (2 of 48 live),
  /// so those accounts never gain a row — and a rotation keyed on row timestamps
  /// therefore reads them as "never fetched" and puts them at the head of the queue
  /// FOREVER, re-spending 12 calls each on a guaranteed empty every single day.
  demographicsFetchedAt DateTime? @map("demographics_fetched_at")

  lastPostSyncAt     DateTime? @map("last_post_sync_at")
  lastPostSyncStatus String?   @map("last_post_sync_status")
  lastPostSyncError  String?   @map("last_post_sync_error")
  disconnectedAt     DateTime? @map("disconnected_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  connection    MetaConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  posts         MetaPost[]
  windowMetrics MetaAssetMetric[]
  demographics  MetaAssetDemographic[]
  daily         MetaAssetDaily[]

  @@unique([connectionId, kind, metaId])
  @@index([selected, kind])
  @@index([socialAccountId])
  @@map("meta_assets")
}

enum MetaAssetKind {
  FACEBOOK_PAGE
  INSTAGRAM_ACCOUNT
}

/// Who an Instagram audience IS — the distribution behind the scalars.
///
/// ⚠️ INSTAGRAM ONLY. Facebook's whole fan-demographic family (page_fans_country,
/// page_fans_city, page_fans_locale …) was retired with the rest of the 2025/26
/// deprecation and returns (#100).
///
/// Replace-on-write per (asset, audience, dimension): buckets come and go as a
/// country drops out of the top set, and an upsert alone would leave the departed
/// one behind forever, quietly inflating every total drawn from this table.
///
/// Refreshed on its OWN daily cadence, not with the 3-hourly channel sync: a full
/// pass is 3 audiences x 4 dimensions x ~48 accounts = ~576 calls, which would
/// more than double the 672-call sync and starve it. Demographics move slowly, so
/// daily with rotation is ample.
model MetaAssetDemographic {
  id      String    @id @default(uuid())
  assetId String    @map("asset_id")
  asset   MetaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// "follower" | "engaged" | "reached"
  audience String
  /// "country" | "city" | "age" | "gender"
  dimension String
  /// The bucket label as Meta returns it — "BD", "Mumbai, Maharashtra", "25-34", "M".
  bucket String
  value  Int

  fetchedAt DateTime @map("fetched_at")

  @@unique([assetId, audience, dimension, bucket])
  @@index([assetId, audience, dimension])
  @@map("meta_asset_demographics")
}

/// Channel metrics for ONE time window. Latest state per (asset, window) — an
/// upsert, never an append, for the same reason MetaPost is (see its note).
///
/// ⚠️ THE WINDOW SET IS DICTATED BY META, NOT BY US, and cannot be widened by
/// adding rows here. Live-probed 2026-08-24:
///
///   Facebook  `period` accepts day | week | days_28 | month. There is no 90-day
///             period, and `lifetime` returns 0 / undefined for these metrics.
///   Instagram total_value accepts an arbitrary since/until but HARD-FAILS past
///             30 days: "(#100) There cannot be more than 30 days (2592000 s)
///             between since and until."
///
/// So day / week / days_28 are the only windows BOTH platforms can answer
/// natively. A longer window cannot be assembled by stitching shorter ones,
/// because reach counts UNIQUE people: adding two 28-day reaches double-counts
/// everyone present in both. Views and engagements would survive that treatment;
/// reach would silently inflate, which is the same trap that produced a 56%
/// overstatement when daily reach was summed. Offer only what Meta measures.
model MetaAssetMetric {
  id      String    @id @default(uuid())
  assetId String    @map("asset_id")
  asset   MetaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// "day" | "week" | "days_28" — Facebook's own vocabulary, mapped to an
  /// equivalent since/until on Instagram.
  window String

  views        BigInt?
  reach        BigInt?
  engagements  BigInt?
  profileViews BigInt? @map("profile_views")
  reactions    BigInt?

  /// Follower change across this window, measured by the platform.
  ///
  /// ⚠️ INSTAGRAM ONLY, and signed (it can be negative). Facebook does not need
  /// it: page_follows gives the true daily total, so its change comes from the
  /// snapshot series. Instagram has no total-over-time metric at all — the only
  /// route to a change is follows_and_unfollows, whose follow_type breakdown
  /// gives FOLLOWER (follows) and NON_FOLLOWER (unfollows); net = follows − unfollows.
  /// Null for the 24h window, which Meta will not break down.
  followerDelta Int? @map("follower_delta")

  /// Gross new follows in the window, and the churn behind the net number.
  ///
  /// ⚠️ These are GROSS, not net. Facebook: page_daily_follows_unique /
  /// page_daily_unfollows_unique. Instagram: the FOLLOWER / NON_FOLLOWER buckets
  /// of follows_and_unfollows, which the follower-change fetch already reads — so
  /// storing them costs nothing extra. Net change stays in `followerDelta`;
  /// showing only net hides that two channels with the same +50k can have wildly
  /// different churn underneath.
  follows   Int?
  unfollows Int?

  /// FACEBOOK only — page_video_view_time, in MILLISECONDS. BigInt because a
  /// large Page clears 5.9e12 ms in 28 days, far past a 32-bit column.
  videoViewTimeMs BigInt? @map("video_view_time_ms")

  /// INSTAGRAM only. Saves and shares are the strongest reach-intent signals on
  /// Instagram and neither has a Facebook page-level equivalent.
  saves           Int?
  shares          Int?
  accountsEngaged Int? @map("accounts_engaged")

  /// Approximate earnings for this window, in CENTS (integer — never a float,
  /// money must not accumulate binary rounding error).
  ///
  /// ⚠️ FACEBOOK ONLY. Instagram exposes no earnings metric at all: its insights
  /// enumeration rejects both monetization names outright. Source is
  /// `monetization_approximate_earnings`, which is the same figure the Meta app
  /// labels "Approximate earnings". Null means Meta returned nothing; 0 means it
  /// returned zero, which for an unmonetised Page is a true answer.
  earningsCents Int? @map("earnings_cents")

  /// When WE fetched. Not the same thing as what the numbers describe.
  fetchedAt DateTime? @map("fetched_at")

  /// The end of the period Meta actually published — its `end_time`.
  ///
  /// ⚠️ THIS IS NOT `fetchedAt`, AND CONFLATING THEM MISLEADS. Facebook closes a
  /// period at the Page's local midnight, so a sync running at 10:02 today
  /// returns figures stamped 2026-08-23T07:00:00Z. Showing the fetch time would
  /// tell a reader the data is current through today, which is exactly the wrong
  /// impression and the reason Meta's own app appears to disagree with us.
  periodEnd DateTime? @map("period_end")

  error     String?

  @@unique([assetId, window])
  @@index([window])
  @@map("meta_asset_metrics")
}

/// ONE DAY of channel metrics for one asset — the store that makes calendar
/// months and arbitrary date ranges answerable without new Graph calls.
///
/// ⚠️ WHY THIS EXISTS. Meta's native windows are day | week | days_28 only
/// (period=month is a ROLLING 30-day window stamped daily, NOT calendar months —
/// live-probed 2026-08-31), and Instagram hard-caps since/until spans at 30 days.
/// So a calendar month or a user-chosen range can never be fetched live in one
/// call. Daily values CAN: summing days is exact for flow metrics (views,
/// engagements, profile views, reactions, follows, unfollows, watch time,
/// earnings).
///
/// ⚠️ REACH IS STORED PER-DAY BUT MUST NEVER BE SUMMED ACROSS DAYS. It counts
/// UNIQUE people; adding days double-counts everyone who returned (the measured
/// 56% overstatement class). Range queries return reach as NULL — an em-dash on
/// the page — because Meta publishes no unique-people figure for custom spans.
///
/// `date` = the calendar day the value DESCRIBES (Facebook: end_time date minus
/// one day, page-local; Instagram: the since date, UTC). Writers: the 3-hourly
/// channel sync persists its day-window fetch here at zero extra API cost, and
/// scripts/backfill-meta-daily.ts loads history (FB ~2 years, IG 90 days — IG
/// has no daily series API, so history costs one call per asset-day; probed
/// 2026-08-31, Meta's own error caps IG at "the last 2 years" with sentinel -1s
/// appearing past ~1 year, which map to NULL, never stored).
model MetaAssetDaily {
  id      String    @id @default(uuid())
  assetId String    @map("asset_id")
  asset   MetaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// The day the values describe, date-only.
  date DateTime @db.Date

  views        BigInt?
  /// Daily unique viewers — valid AS A DAY, poisonous summed. See model doc.
  reach        BigInt?
  engagements  BigInt?
  profileViews BigInt? @map("profile_views")
  reactions    BigInt?
  follows      Int?
  unfollows    Int?
  videoViewTimeMs BigInt? @map("video_view_time_ms")
  saves           Int?
  shares          Int?
  accountsEngaged Int?    @map("accounts_engaged")
  /// Integer cents — money never rides a float. Facebook only.
  earningsCents   Int?    @map("earnings_cents")

  @@unique([assetId, date])
  @@index([date])
  @@map("meta_asset_daily")
}

/// ⚠️ LATEST-STATE-PER-POST, upserted on (assetId, metaPostId). NOT a time series.
/// link_metrics grew to 3.99M rows / 1266MB precisely because it APPENDS per poll,
/// and a DISTINCT ON over it measured 9.8s/1.25GB while evicting the covering index
/// that /reports depends on. This table is bounded instead: (selected assets ×
/// posts inside META_POST_RETENTION_DAYS), trimmed by one bounded deleteMany per run.
model MetaPost {
  id               String    @id @default(uuid())
  assetId          String    @map("asset_id")
  /// FB: the "{pageId}_{postId}" COMPOSITE — the ONLY id /insights accepts.
  /// IG: the numeric media id.
  metaPostId       String    @map("meta_post_id")
  /// The id canonicalKey() would derive (FB permalink reel id, IG shortcode).
  /// Indexed for a POSSIBLE future correlation; this design NEVER joins on it.
  matchId          String?   @map("match_id")
  permalink        String?
  caption          String?   @db.Text
  mediaType        String?   @map("media_type")
  mediaProductType String?   @map("media_product_type")
  postedAt         DateTime? @map("posted_at")

  /// NULL = "Meta publishes no such number for this post type".
  /// ⚠️ NEVER coerce to 0 — that is the documented fabricated-zero bug class
  /// (the Snapchat showLikes incident), where a genuinely-absent metric was
  /// rendered as a real zero and read as "this post got no likes".
  views    Int?
  likes    Int?
  comments Int?
  shares   Int?
  saves    Int?
  reach    Int?

  /// pending | ok | partial | unavailable | rate_limited | error
  /// ⚠️ "pending" (stored, not yet measured) MUST render differently from
  /// "unavailable" (measured, Meta publishes nothing).
  metricsStatus    String    @default("pending") @map("metrics_status")
  metricsFetchedAt DateTime? @map("metrics_fetched_at")
  metricsError     String?   @map("metrics_error")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  asset MetaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, metaPostId])
  @@index([assetId, postedAt(sort: Desc)])
  @@index([assetId, metricsStatus, postedAt])
  @@index([postedAt(sort: Desc)])
  @@index([matchId])
  @@map("meta_posts")
}
