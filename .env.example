# ============================================================
# Dashmani Platform — environment template
# Copy this file to .env (root), apps/api/.env, AND packages/db/.env
# All three locations must have the same DATABASE_URL / JWT secrets
# ============================================================

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL=postgresql://user:password@localhost:5432/dashmani

# --- Redis (matches docker-compose.yml defaults) ---
REDIS_URL=redis://localhost:6379

# --- JWT (change in production — use long random strings) ---
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-refresh

# --- API ---
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# --- Seeding (required for npm run db:seed — never commit actual value) ---
SEED_ADMIN_PASSWORD=Admin@123456
# Optional. Sets/resets tabish@dashmani.com (internal + client portal) on every seed run.
# Leave blank to keep that account's existing password. Never put the real one in git.
SEED_TABISH_PASSWORD=
# Optional, LOCAL ONLY. Creates demo@clientcompany.com with this password; blank = skipped.
SEED_DEMO_CLIENT_PASSWORD=

# --- App URLs (used in reset-password and notification emails) ---
INTERNAL_APP_URL=http://localhost:3000
HR_APP_URL=http://localhost:3002

# --- SMTP (optional — emails silently no-op if missing) ---
# Use a Gmail App Password: Google Account → Security → App Passwords (needs 2FA)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hr@digitalsukoon.com
SMTP_PASS=your-gmail-app-password
# Inbox that receives campaign enquiries from the digitalsukoon.com contact form
SITE_ENQUIRY_TO=hello@digitalsukoon.com

# --- Campaign booking (client portal "Campaigns") ---
# Payment mode. Without Razorpay keys (or with CAMPAIGN_PAYMENT_MODE=offline) checkout runs
# "offline": the booking is submitted for review with no online payment and the amount is
# collected by hand. Set the keys (and unset the override) to switch to Razorpay — no deploy.
# Webhook: https://api.digitalsukoon.com/v1/webhooks/razorpay
CAMPAIGN_PAYMENT_MODE=offline
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Private media folder (never under uploads/). Prod: /var/lib/dashmani/campaign-media
CAMPAIGN_MEDIA_DIR=
# Optional knobs: CAMPAIGN_MIN_FREE_GB=5  CAMPAIGN_CLIENT_QUOTA_GB=2  CAMPAIGN_RETENTION_DAYS=14
#                 CAMPAIGN_RENDER_ENABLED=1  CAMPAIGN_TEAM_EMAIL=hello@digitalsukoon.com
# Phase 2 auto-publish through the Meta API — OFF unless set to 1.
CAMPAIGN_PUBLISH_ENABLED=0
# Public origin Meta downloads the media from (signed links). CAMPAIGN_PUBLISH_HOUR_IST=10
API_PUBLIC_URL=https://api.digitalsukoon.com
CLIENT_APP_URL=http://localhost:3001
# Phase 3 YouTube auto-upload — OFF unless set to 1 (independent of CAMPAIGN_PUBLISH_ENABLED).
# Needs a Google Cloud OAuth client (Web application) whose Authorized redirect URI is
# YOUTUBE_OAUTH_REDIRECT_URI (default ${API_PUBLIC_URL}/v1/youtube/oauth/callback), the YouTube
# Data API v3 enabled, and META_TOKEN_ENC_KEY (refresh tokens are stored encrypted).
CAMPAIGN_YOUTUBE_PUBLISH_ENABLED=0
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# YOUTUBE_OAUTH_REDIRECT_URI=
# CAMPAIGN_YOUTUBE_DAILY_UPLOADS=5   CAMPAIGN_YOUTUBE_PRIVACY=public (public|unlisted|private)

# --- "Sign in with Google" on the client, HR and internal portals ---
# ONE Google Cloud OAuth client id of type "Web application" whose Authorized JavaScript
# origins include all three portals: https://client.digitalsukoon.com, https://hr.digitalsukoon.com,
# https://portal.digitalsukoon.com (and http://localhost:3001, :3002, :3000 locally). The internal
# portal only signs in EXISTING accounts (invite-only); it never creates one. No secret is needed: the browser's
# Google button yields an ID token the API verifies with Google. Runtime-only (served to each
# portal by GET /v1/client/auth/google/config, /v1/hr/auth/google/config and /v1/auth/google/config) — set it in
# apps/api/.env and `pm2 restart api`; blank hides the button on all three.
GOOGLE_CLIENT_ID=
# The iOS app's own Google OAuth client(s) (type "iOS", bundle com.dashmani.employee), comma-separated.
# Its ID tokens carry this id as the audience, so the API must accept it too. Runtime-only.
GOOGLE_IOS_CLIENT_IDS=

# --- Creator portal (creators.digitalsukoon.com — apps/creators, a static export served by nginx) ---
# Dark unless exactly "1": with anything else every /v1/creator/* route answers 503. Runtime-only
# (no rebuild) — set it in apps/api/.env and `pm2 restart api`. scripts/setup-creators.sh writes
# the keys below on the box but never this switch.
CREATORS_ENABLED=0
# The creators app origin: CORS, email links and where the Meta connect returns (local: :3005).
CREATORS_APP_URL=http://localhost:3005
# Sales portal origin (CORS). Prod: https://sales.digitalsukoon.com
SALES_APP_URL=http://localhost:3006
# Public site, for the portal switchers' links (defaults to https://digitalsukoon.com in production).
WEB_APP_URL=http://localhost:3004
# Creator sessions are signed with THEIR OWN secrets (and aud "creators"), never JWT_SECRET, so a
# creator token is invalid on every staff/HR/client route and vice versa. Two different long random
# strings (`openssl rand -hex 32`). Required in production (missing → 503); rotating them signs
# every creator out.
CREATOR_JWT_SECRET=
CREATOR_JWT_REFRESH_SECRET=
# Facebook Login for creators. No default: unset → "Connect Facebook" answers 503 META_NOT_CONFIGURED.
# Must byte-match a Valid OAuth Redirect URI in the Meta app dashboard.
# Prod: https://api.digitalsukoon.com/v1/creator/meta/oauth/callback
META_CREATOR_REDIRECT_URI=
# Optional: a separate Meta app for creators. Blank = the admin connect's app
# (META_OAUTH_APP_ID / META_OAUTH_APP_SECRET, "Post Automation 2"). Tokens are encrypted with the
# existing META_TOKEN_ENC_KEY.
CREATOR_META_APP_ID=
CREATOR_META_APP_SECRET=
# Graph calls the daily creator-page metrics refresh may spend in total (default 200).
CREATOR_METRICS_CALL_BUDGET=200
# Hard daily ceiling on creator verification + reset emails, all creators together (default 300).
# They go out from the same Gmail account as every portal's password resets, so a scripted
# sign-up flood must never be able to exhaust it. Over the cap sign-up still works, without its email.
CREATOR_EMAIL_DAILY_CAP=300
# Staff "new creator signed up" alerts per day (default 25); past it, the review queue is the record.
CREATOR_SIGNUP_ALERT_DAILY_CAP=25
# Creator sign-ups per hour per client IP (= the Cloudflare edge IP; default 30).
RATE_LIMIT_CREATOR_SIGNUP_IP_MAX=30
# Kill switch for the creator background jobs (token health, metrics, state pruning): 0 = off.
CREATOR_CRONS_ENABLED=1
