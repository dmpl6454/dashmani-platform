generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH & RBAC ============

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  passwordHash   String   @map("password_hash")
  phone          String?
  profileImageUrl String? @map("profile_image_url")
  status         UserStatus @default(ONBOARDING)
  orgUnitId      String?  @map("org_unit_id")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  orgUnit        OrgUnit?  @relation(fields: [orgUnitId], references: [id])
  roles          UserRole[]
  attendanceRecords Attendance[]
  leaveRequests  LeaveRequest[] @relation("LeaveRequester")
  leaveApprovals LeaveRequest[] @relation("LeaveApprover")
  auditLogs      AuditLog[]
  refreshTokens  RefreshToken[]
  assignedAccounts   AccountAssignment[] @relation("AccountAssignee")
  accountAssignments AccountAssignment[] @relation("AccountAssigner")
  assignedTasks      Task[]              @relation("TaskAssignee")
  createdTasks       Task[]              @relation("TaskCreator")
  taskComments       TaskComment[]       @relation("CommentAuthor")
  postComments       PostComment[]       @relation("PostCommentAuthor")
  uploadedFiles      ProjectFile[] @relation("FileUploader")
  approvalRequests   Approval[]    @relation("ApprovalRequester")
  contentPosts       ContentPost[] @relation("ContentCreator")
  otpTokens          OtpToken[]
  dailyReports       DailyReport[]
  notifications      Notification[]
  announcementsSent  Announcement[] @relation("AnnouncementsSent")
  profile            EmployeeProfile?
  salarySlips        SalarySlip[]      @relation("SalarySlipEmployee")
  documents          EmployeeDocument[] @relation("DocumentEmployee")
  profilePicRequests ProfilePictureRequest[] @relation("ProfilePicEmployee")
  offerLetters       OfferLetter[]     @relation("OfferLetterEmployee")
  contracts          EmploymentContract[] @relation("ContractEmployee")
  extraWorkHours     ExtraWorkHour[]     @relation("ExtraWorkEmployee")
  incentives         Incentive[]         @relation("IncentiveEmployee")
  reviewsReceived    PerformanceReview[] @relation("ReviewEmployee")
  reviewsGiven       PerformanceReview[] @relation("ReviewReviewer")
  bugReports         BugReport[]         @relation("BugReporter")
  expenseClaims      ExpenseClaim[]      @relation("ExpenseEmployee")
  presentations      Presentation[]      @relation("PresentationEmployee")
  assignedDevices    AssignedDevice[]    @relation("DeviceEmployee")
  dailyPOAs          DailyPOA[]          @relation("POAEmployee")
  complaints         Complaint[]         @relation("ComplaintEmployee")

  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  ONBOARDING
}

model Role {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users        UserRole[]
  permissions  RolePermission[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id       String @id @default(uuid())
  roleId   String @map("role_id")
  resource String
  action   String
  scope    String

  role     Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action, scope])
  @@map("role_permissions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ============ ORGANIZATION ============

model OrgUnit {
  id        String      @id @default(uuid())
  name      String
  type      OrgUnitType
  parentId  String?     @map("parent_id")
  leadId    String?     @map("lead_id")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  parent    OrgUnit?  @relation("OrgHierarchy", fields: [parentId], references: [id])
  children  OrgUnit[] @relation("OrgHierarchy")
  members   User[]

  @@map("org_units")
}

enum OrgUnitType {
  DEPARTMENT
  TEAM
  SUB_TEAM
}

// ============ ATTENDANCE ============

model Attendance {
  id            String           @id @default(uuid())
  employeeId    String           @map("employee_id")
  date          DateTime         @db.Date
  checkIn       DateTime?        @map("check_in")
  checkOut      DateTime?        @map("check_out")
  status        AttendanceStatus @default(PRESENT)
  overtimeHours Float            @default(0) @map("overtime_hours")
  ipAddress     String?          @map("ip_address")
  note          String?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  employee      User @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@map("attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

model LeaveRequest {
  id          String      @id @default(uuid())
  employeeId  String      @map("employee_id")
  startDate   DateTime    @map("start_date") @db.Date
  endDate     DateTime    @map("end_date") @db.Date
  type        LeaveType
  reason      String
  status      LeaveStatus @default(PENDING)
  approvedBy  String?     @map("approved_by")
  approvedAt  DateTime?   @map("approved_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  employee    User @relation("LeaveRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  approver    User? @relation("LeaveApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@map("leave_requests")
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  UNPAID
  WFH
  COMP_OFF
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============ SETTINGS ============

model Setting {
  id        String   @id @default(uuid())
  namespace String
  key       String
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([namespace, key])
  @@map("settings")
}

// ============ AUDIT ============

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

// ============ PLATFORMS & SOCIAL ACCOUNTS ============

model Platform {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  iconUrl   String?  @map("icon_url")
  createdAt DateTime @default(now()) @map("created_at")

  accounts  SocialAccount[]

  @@map("platforms")
}

model SocialAccount {
  id              String        @id @default(uuid())
  handle          String
  displayName     String        @map("display_name")
  platformId      String        @map("platform_id")
  clientName      String?       @map("client_name")
  status          AccountStatus @default(ACTIVE)
  profileUrl      String?       @map("profile_url")
  followerCount   Int           @default(0) @map("follower_count")
  lastSyncedAt    DateTime?     @map("last_synced_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  platform        Platform @relation(fields: [platformId], references: [id])
  assignments     AccountAssignment[]
  tasks           Task[]
  projectAccounts    ProjectAccount[]
  contentPosts    ContentPost[]
  reportLinks          ReportLink[]
  growthSnapshots      AccountGrowthSnapshot[]

  @@unique([handle, platformId])
  @@map("social_accounts")
}

enum AccountStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model AccountAssignment {
  id           String   @id @default(uuid())
  accountId    String   @map("account_id")
  employeeId   String   @map("employee_id")
  assignedBy   String   @map("assigned_by")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")
  reason       String?

  account      SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee     User          @relation("AccountAssignee", fields: [employeeId], references: [id], onDelete: Cascade)
  assigner     User          @relation("AccountAssigner", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([employeeId])
  @@map("account_assignments")
}

// ============ TASKS ============

model Task {
  id            String       @id @default(uuid())
  title         String
  description   String?
  status        TaskStatus   @default(TODO)
  priority      TaskPriority @default(MEDIUM)
  assigneeId    String?      @map("assignee_id")
  createdById   String       @map("created_by_id")
  accountId     String?      @map("account_id")
  dueDate       DateTime?    @map("due_date")
  completedAt   DateTime?    @map("completed_at")
  dependsOnId   String?      @map("depends_on_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  assignee      User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  account       SocialAccount? @relation(fields: [accountId], references: [id])
  dependsOn     Task?          @relation("TaskDependency", fields: [dependsOnId], references: [id])
  dependedOnBy  Task[]         @relation("TaskDependency")
  comments      TaskComment[]
  projectTasks       ProjectTask[]

  @@index([assigneeId])
  @@index([status])
  @@index([accountId])
  @@map("tasks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_comments")
}

// ============ CLIENTS ============

model Client {
  id             String       @id @default(uuid())
  companyName    String       @map("company_name")
  contactName    String       @map("contact_name")
  email          String       @unique
  passwordHash   String       @map("password_hash")
  phone          String?
  logoUrl        String?      @map("logo_url")
  status         ClientStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  projects       Project[]
  refreshTokens  ClientRefreshToken[]
  otpTokens      OtpToken[]

  @@map("clients")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ONBOARDING
}

model ClientInvite {
  id        String    @id @default(uuid())
  email     String    @unique
  token     String    @unique @default(uuid())
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now())

  @@map("client_invites")
}

model AdminInvite {
  id          String    @id @default(uuid())
  email       String    @unique
  token       String    @unique @default(uuid())
  roleIds     String[]  @map("role_ids")
  designation String?
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("admin_invites")
}

model ClientRefreshToken {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_refresh_tokens")
}

// ============ PROJECTS ============

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  clientId    String        @map("client_id")
  status      ProjectStatus @default(ACTIVE)
  healthScore Int?          @map("health_score")
  startDate   DateTime?     @map("start_date") @db.Date
  endDate     DateTime?     @map("end_date") @db.Date
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  client      Client     @relation(fields: [clientId], references: [id])
  accounts    ProjectAccount[]
  tasks       ProjectTask[]
  files       ProjectFile[]
  approvals   Approval[]
  contentPosts ContentPost[]

  @@index([clientId])
  @@map("projects")
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model ProjectAccount {
  id        String @id @default(uuid())
  projectId String @map("project_id")
  accountId String @map("account_id")

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  account   SocialAccount @relation(fields: [accountId], references: [id])

  @@unique([projectId, accountId])
  @@map("project_accounts")
}

model ProjectTask {
  id        String @id @default(uuid())
  projectId String @map("project_id")
  taskId    String @map("task_id")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task    @relation(fields: [taskId], references: [id])

  @@unique([projectId, taskId])
  @@map("project_tasks")
}

model ProjectFile {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  name        String
  url         String
  size        Int      @default(0)
  mimeType    String?  @map("mime_type")
  uploadedById String  @map("uploaded_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy  User    @relation("FileUploader", fields: [uploadedById], references: [id])

  @@index([projectId])
  @@map("project_files")
}

model Approval {
  id          String         @id @default(uuid())
  projectId   String         @map("project_id")
  title       String
  description String?
  fileUrl     String?        @map("file_url")
  status      ApprovalStatus @default(PENDING)
  requestedById String       @map("requested_by_id")
  respondedAt DateTime?      @map("responded_at")
  clientNote  String?        @map("client_note")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("ApprovalRequester", fields: [requestedById], references: [id])

  @@index([projectId])
  @@index([status])
  @@map("approvals")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

// ============ CONTENT ============

model ContentPost {
  id            String        @id @default(uuid())
  title         String
  caption       String?       @db.Text
  mediaUrls     String[]      @map("media_urls")
  projectId     String        @map("project_id")
  accountId     String?       @map("account_id")
  status        ContentStatus @default(DRAFT)
  format        String?
  aspectRatio   String?       @map("aspect_ratio")
  hashtags      String[]      @default([])
  scheduledAt   DateTime?     @map("scheduled_at")
  publishedAt   DateTime?     @map("published_at")
  createdById   String        @map("created_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  project       Project       @relation(fields: [projectId], references: [id])
  account       SocialAccount? @relation(fields: [accountId], references: [id])
  createdBy     User          @relation("ContentCreator", fields: [createdById], references: [id])
  comments      PostComment[]

  @@index([projectId])
  @@index([accountId])
  @@index([status])
  @@index([scheduledAt])
  @@map("content_posts")
}

enum ContentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
  REJECTED
}

model PostComment {
  id        String      @id @default(uuid())
  postId    String      @map("post_id")
  authorId  String      @map("author_id")
  body      String      @db.Text
  createdAt DateTime    @default(now())

  post      ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User        @relation("PostCommentAuthor", fields: [authorId], references: [id])

  @@map("post_comments")
}

// ============ EMPLOYEE PROFILE ============

model EmployeeProfile {
  id                     String   @id @default(uuid())
  userId                 String   @unique @map("user_id")
  designation            String?
  jobDescription         String?  @map("job_description") @db.Text
  salary                 Float?
  bankAccountHolderName  String?  @map("bank_account_holder_name")
  bankAccountNumber      String?  @map("bank_account_number")
  bankName               String?  @map("bank_name")
  bankBranch             String?  @map("bank_branch")
  ifscCode               String?  @map("ifsc_code")
  mailingAddress         String?  @map("mailing_address") @db.Text
  aadhaarNumber          String?  @map("aadhaar_number")
  panNumber              String?  @map("pan_number")
  familyContact1Name     String?  @map("family_contact1_name")
  familyContact1Phone    String?  @map("family_contact1_phone")
  familyContact1Relation String?  @map("family_contact1_relation")
  familyContact2Name     String?  @map("family_contact2_name")
  familyContact2Phone    String?  @map("family_contact2_phone")
  familyContact2Relation String?  @map("family_contact2_relation")
  joiningDate            DateTime? @map("joining_date") @db.Date
  joiningDateApproved    Boolean   @default(false) @map("joining_date_approved")
  sopAcceptedAt          DateTime? @map("sop_accepted_at")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  user                   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employee_profiles")
}

// ============ HR PORTAL ============

model OtpToken {
  id        String     @id @default(uuid())
  userId    String?    @map("user_id")
  clientId  String?    @map("client_id")
  otp       String
  channel   OtpChannel
  target    String
  expiresAt DateTime   @map("expires_at")
  verified  Boolean    @default(false)
  createdAt DateTime   @default(now()) @map("created_at")

  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId, otp])
  @@index([clientId, otp])
  @@index([expiresAt])
  @@map("otp_tokens")
}

enum OtpChannel {
  EMAIL
  SMS
  WHATSAPP
}

model DailyReport {
  id            String   @id @default(uuid())
  employeeId    String   @map("employee_id")
  date          DateTime @db.Date
  notes         String?  @db.Text
  latitude      Float?
  longitude     Float?
  submittedFrom String?  @map("submitted_from")
  submittedAt   DateTime @default(now()) @map("submitted_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  employee      User         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  links         ReportLink[]

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@map("daily_reports")
}

model ReportLink {
  id           String   @id @default(uuid())
  reportId     String   @map("report_id")
  accountId    String   @map("account_id")
  url          String?
  platform     String
  description  String?
  mediaUrl     String?  @map("media_url")
  likes        Int?
  comments     Int?
  shares       Int?
  views        Int?
  isScheduled  Boolean  @default(false) @map("is_scheduled")
  scheduledFor DateTime? @map("scheduled_for")
  createdAt    DateTime @default(now()) @map("created_at")

  report       DailyReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  account      SocialAccount @relation(fields: [accountId], references: [id])

  @@index([reportId])
  @@index([accountId])
  @@index([url])
  @@map("report_links")
}

model AccountGrowthSnapshot {
  id             String   @id @default(uuid())
  accountId      String   @map("account_id")
  date           DateTime @db.Date
  followerCount  Int      @map("follower_count")
  followingCount Int?     @map("following_count")
  postCount      Int?     @map("post_count")
  engagementRate Float?   @map("engagement_rate")
  createdAt      DateTime @default(now()) @map("created_at")

  account        SocialAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, date])
  @@index([accountId, date])
  @@map("account_growth_snapshots")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  REPORT_REMINDER
  REPORT_SUBMITTED
  REPORT_MISSED
  GROWTH_MILESTONE
  ACCOUNT_ASSIGNED
  LEAVE_REQUEST
  LEAVE_APPROVED
  LEAVE_REJECTED
  SALARY_SLIP
  DOCUMENT_UPLOADED
  PROFILE_PICTURE
  PERFORMANCE_REVIEW
  BUG_REPORT_UPDATE
  INCENTIVE_AWARDED
  EXTRA_HOURS_APPROVED
  GENERAL
  ANNOUNCEMENT
}

// ============ ANNOUNCEMENTS ============

model Announcement {
  id             String   @id @default(uuid())
  title          String
  message        String   @db.Text
  sentById       String   @map("sent_by_id")
  recipientCount Int      @default(0) @map("recipient_count")
  createdAt      DateTime @default(now()) @map("created_at")

  sentBy         User     @relation("AnnouncementsSent", fields: [sentById], references: [id])

  @@index([createdAt])
  @@map("announcements")
}

// ============ SALARY SLIPS ============

model SalarySlip {
  id              String          @id @default(uuid())
  employeeId      String          @map("employee_id")
  month           Int
  year            Int
  basicSalary     Float           @map("basic_salary")
  hra             Float           @default(0)
  conveyance      Float           @default(0)
  medicalAllowance Float          @default(0) @map("medical_allowance")
  specialAllowance Float          @default(0) @map("special_allowance")
  otherEarnings   Float           @default(0) @map("other_earnings")
  pf              Float           @default(0)
  esi             Float           @default(0)
  tax             Float           @default(0)
  otherDeductions Float           @default(0) @map("other_deductions")
  netSalary       Float           @map("net_salary")
  status          SalarySlipStatus @default(DRAFT)
  generatedBy     String?         @map("generated_by")
  approvedBy      String?         @map("approved_by")
  approvedAt      DateTime?       @map("approved_at")
  remarks         String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  employee        User @relation("SalarySlipEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([status])
  @@map("salary_slips")
}

enum SalarySlipStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// ============ EMPLOYEE DOCUMENTS ============

model EmployeeDocument {
  id            String         @id @default(uuid())
  employeeId    String         @map("employee_id")
  documentType  DocumentType   @map("document_type")
  fileName      String         @map("file_name")
  filePath      String         @map("file_path")
  fileSize      Int            @map("file_size")
  mimeType      String         @map("mime_type")
  status        DocumentStatus @default(PENDING)
  reviewedBy    String?        @map("reviewed_by")
  reviewedAt    DateTime?      @map("reviewed_at")
  reviewNotes   String?        @map("review_notes")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  employee      User @relation("DocumentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@map("employee_documents")
}

enum DocumentType {
  AADHAAR
  PAN
  PASSPORT
  DRIVING_LICENSE
  VOTER_ID
  BANK_PASSBOOK
  EDUCATION_CERTIFICATE
  EXPERIENCE_LETTER
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============ PROFILE PICTURE REQUESTS ============

model ProfilePictureRequest {
  id            String                  @id @default(uuid())
  employeeId    String                  @map("employee_id")
  filePath      String                  @map("file_path")
  status        ProfilePictureStatus    @default(PENDING)
  approvedBy    String?                 @map("approved_by")
  approvedAt    DateTime?               @map("approved_at")
  createdAt     DateTime                @default(now()) @map("created_at")

  employee      User @relation("ProfilePicEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@map("profile_picture_requests")
}

enum ProfilePictureStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============ OFFER LETTERS ============

model OfferLetter {
  id              String   @id @default(uuid())
  employeeId      String   @map("employee_id")
  offerDate       DateTime @map("offer_date") @db.Date
  joiningDate     DateTime @map("joining_date") @db.Date
  designation     String
  department      String?
  salary          Float
  probationMonths Int      @default(3) @map("probation_months")
  location        String?
  generatedBy     String   @map("generated_by")
  createdAt       DateTime @default(now()) @map("created_at")

  employee        User @relation("OfferLetterEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("offer_letters")
}

// ============ EMPLOYMENT CONTRACTS ============

model EmploymentContract {
  id              String   @id @default(uuid())
  employeeId      String   @map("employee_id")
  contractDate    DateTime @map("contract_date") @db.Date
  designation     String
  department      String?
  salary          Float
  probationMonths Int      @default(3) @map("probation_months")
  noticePeriod    Int      @default(30) @map("notice_period")
  agreedAt        DateTime? @map("agreed_at")
  agreedFromIp    String?  @map("agreed_from_ip")
  createdAt       DateTime @default(now()) @map("created_at")

  employee        User @relation("ContractEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employment_contracts")
}

// ============ HOLIDAYS ============

model Holiday {
  id          String      @id @default(uuid())
  name        String
  date        DateTime    @db.Date
  type        HolidayType @default(PUBLIC)
  description String?
  createdAt   DateTime    @default(now()) @map("created_at")

  @@unique([date])
  @@index([date])
  @@map("holidays")
}

enum HolidayType {
  PUBLIC
  RESTRICTED
  COMPANY
}

// ============ EXTRA WORK HOURS & INCENTIVES ============

model ExtraWorkHour {
  id            String   @id @default(uuid())
  employeeId    String   @map("employee_id")
  date          DateTime @db.Date
  hours         Float
  description   String?  @db.Text
  status        ApprovalState @default(PENDING)
  approvedBy    String?  @map("approved_by")
  approvedAt    DateTime? @map("approved_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  employee      User @relation("ExtraWorkEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@map("extra_work_hours")
}

model Incentive {
  id            String        @id @default(uuid())
  employeeId    String        @map("employee_id")
  amount        Float
  reason        String
  month         Int?
  year          Int?
  awardedBy     String        @map("awarded_by")
  createdAt     DateTime      @default(now()) @map("created_at")

  employee      User @relation("IncentiveEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("incentives")
}

enum ApprovalState {
  PENDING
  APPROVED
  REJECTED
}

// ============ PERFORMANCE REVIEWS ============

model PerformanceReview {
  id            String   @id @default(uuid())
  employeeId    String   @map("employee_id")
  reviewerId    String   @map("reviewer_id")
  period        String
  rating        Int
  strengths     String?  @db.Text
  improvements  String?  @db.Text
  comments      String?  @db.Text
  goals         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  employee      User @relation("ReviewEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer      User @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@map("performance_reviews")
}

// ============ BUG REPORTS ============

model BugReport {
  id            String        @id @default(uuid())
  reportedBy    String        @map("reported_by")
  title         String
  description   String        @db.Text
  page          String?
  severity      BugSeverity   @default(MEDIUM)
  status        BugStatus     @default(OPEN)
  screenshot    String?
  resolution    String?       @db.Text
  resolvedAt    DateTime?     @map("resolved_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  reporter      User @relation("BugReporter", fields: [reportedBy], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([reportedBy])
  @@map("bug_reports")
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  WONT_FIX
}

// ============ PRESENTATIONS ============

model Presentation {
  id            String   @id @default(uuid())
  employeeId    String   @map("employee_id")
  title         String
  markdown      String   @db.Text
  theme         String   @default("default")
  htmlPath      String?  @map("html_path")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  employee      User @relation("PresentationEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("presentations")
}

// ============ EXPENSE CLAIMS ============

model ExpenseClaim {
  id            String        @id @default(uuid())
  employeeId    String        @map("employee_id")
  title         String
  amount        Float
  category      String        @default("OTHER")
  description   String?       @db.Text
  receiptUrl    String?       @map("receipt_url")
  status        ApprovalState @default(PENDING)
  reviewedBy    String?       @map("reviewed_by")
  reviewedAt    DateTime?     @map("reviewed_at")
  reviewNotes   String?       @map("review_notes") @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  employee      User @relation("ExpenseEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@map("expense_claims")
}

// ============ ASSIGNED DEVICES ============

model AssignedDevice {
  id            String       @id @default(uuid())
  employeeId    String       @map("employee_id")
  type          DeviceType
  brand         String
  model         String
  serialNumber  String?      @map("serial_number")
  assetTag      String?      @map("asset_tag")
  condition     String       @default("Good")
  notes         String?      @db.Text
  assignedAt    DateTime     @default(now()) @map("assigned_at")
  returnedAt    DateTime?    @map("returned_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  employee      User @relation("DeviceEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("assigned_devices")
}

enum DeviceType {
  LAPTOP
  PHONE
  TABLET
  MONITOR
  KEYBOARD
  MOUSE
  HEADSET
  OTHER
}

// ============ DAILY POA (Plan of Action) ============

model DailyPOA {
  id            String   @id @default(uuid())
  employeeId    String   @map("employee_id")
  date          DateTime @db.Date
  tasks         String   @db.Text
  achievements  String?  @db.Text
  blockers      String?  @db.Text
  tomorrowPlan  String?  @map("tomorrow_plan") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  employee      User @relation("POAEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date], name: "employeeId_date")
  @@index([employeeId])
  @@index([date])
  @@map("daily_poas")
}

// ============ COMPLAINTS ============

model Complaint {
  id            String          @id @default(uuid())
  employeeId    String          @map("employee_id")
  subject       String
  description   String          @db.Text
  category      String          @default("GENERAL")
  status        ComplaintStatus @default(OPEN)
  adminResponse String?         @map("admin_response") @db.Text
  resolvedAt    DateTime?       @map("resolved_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  employee      User @relation("ComplaintEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@map("complaints")
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

// ============ INTERNSHIP APPLICATIONS ============

model InternshipApplication {
  id              String             @id @default(uuid())
  name            String
  email           String
  phone           String?
  college         String?
  course          String?
  startDate       DateTime?          @map("start_date") @db.Date
  duration        String             @default("6 months")
  department      String?
  skills          String?            @db.Text
  portfolio       String?
  linkedin        String?
  coverLetter     String?            @map("cover_letter") @db.Text
  resumeUrl       String?            @map("resume_url")
  status          ApplicationStatus  @default(RECEIVED)
  reviewNotes     String?            @map("review_notes") @db.Text
  reviewedBy      String?            @map("reviewed_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@map("internship_applications")
}

// ============ JOB LISTINGS ============

model JobListing {
  id              String        @id @default(uuid())
  title           String
  department      String?
  location        String?
  type            JobType       @default(FULL_TIME)
  experience      String?
  salary          String?
  description     String        @db.Text
  requirements    String?       @db.Text
  responsibilities String?      @db.Text
  benefits        String?       @db.Text
  status          JobListingStatus @default(ACTIVE)
  createdBy       String        @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  applications    JobApplication[]

  @@index([status])
  @@map("job_listings")
}

model JobApplication {
  id              String              @id @default(uuid())
  jobId           String              @map("job_id")
  applicantName   String              @map("applicant_name")
  applicantEmail  String              @map("applicant_email")
  applicantPhone  String?             @map("applicant_phone")
  resumeUrl       String?             @map("resume_url")
  coverLetter     String?             @map("cover_letter") @db.Text
  experience      String?
  currentCompany  String?             @map("current_company")
  linkedinUrl     String?             @map("linkedin_url")
  portfolioUrl    String?             @map("portfolio_url")
  status          ApplicationStatus   @default(RECEIVED)
  notes           String?             @db.Text
  reviewedBy      String?             @map("reviewed_by")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  job             JobListing @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@index([status])
  @@map("job_applications")
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum JobListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  RECEIVED
  REVIEWING
  SHORTLISTED
  INTERVIEW
  OFFERED
  HIRED
  ACCEPTED
  REJECTED
}
