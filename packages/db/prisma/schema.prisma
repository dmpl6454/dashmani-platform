generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH & RBAC ============

model User {
  id              String     @id @default(uuid())
  name            String
  email           String     @unique
  passwordHash    String     @map("password_hash")
  phone           String?
  profileImageUrl String?    @map("profile_image_url")
  status          UserStatus @default(ONBOARDING)
  orgUnitId       String?    @map("org_unit_id")
  deletedAt       DateTime?  @map("deleted_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  // orgUnit = the user's PRIMARY team (denormalized for single-team read paths:
  // leaderboard, announcements, analytics). teamMemberships is the full set —
  // a user can belong to multiple teams. Primary is always one of the memberships.
  orgUnit            OrgUnit?                @relation(fields: [orgUnitId], references: [id])
  teamMemberships    TeamMembership[]
  roles              UserRole[]
  attendanceRecords  Attendance[]
  leaveRequests      LeaveRequest[]          @relation("LeaveRequester")
  leaveApprovals     LeaveRequest[]          @relation("LeaveApprover")
  auditLogs          AuditLog[]
  refreshTokens      RefreshToken[]
  assignedAccounts   AccountAssignment[]     @relation("AccountAssignee")
  accountAssignments AccountAssignment[]     @relation("AccountAssigner")
  assignedTasks      Task[]                  @relation("TaskAssignee")
  createdTasks       Task[]                  @relation("TaskCreator")
  taskComments       TaskComment[]           @relation("CommentAuthor")
  postComments       PostComment[]           @relation("PostCommentAuthor")
  uploadedFiles      ProjectFile[]           @relation("FileUploader")
  approvalRequests   Approval[]              @relation("ApprovalRequester")
  contentPosts       ContentPost[]           @relation("ContentCreator")
  otpTokens          OtpToken[]
  dailyReports       DailyReport[]
  notifications      Notification[]
  announcementsSent  Announcement[]          @relation("AnnouncementsSent")
  profile            EmployeeProfile?
  salarySlips        SalarySlip[]            @relation("SalarySlipEmployee")
  documents          EmployeeDocument[]      @relation("DocumentEmployee")
  profilePicRequests ProfilePictureRequest[] @relation("ProfilePicEmployee")
  offerLetters       OfferLetter[]           @relation("OfferLetterEmployee")
  contracts          EmploymentContract[]    @relation("ContractEmployee")
  extraWorkHours     ExtraWorkHour[]         @relation("ExtraWorkEmployee")
  incentives         Incentive[]             @relation("IncentiveEmployee")
  reviewsReceived    PerformanceReview[]     @relation("ReviewEmployee")
  reviewsGiven       PerformanceReview[]     @relation("ReviewReviewer")
  bugReports         BugReport[]             @relation("BugReporter")
  expenseClaims      ExpenseClaim[]          @relation("ExpenseEmployee")
  presentations      Presentation[]          @relation("PresentationEmployee")
  assignedDevices    AssignedDevice[]        @relation("DeviceEmployee")
  dailyPOAs          DailyPOA[]              @relation("POAEmployee")
  complaints         Complaint[]             @relation("ComplaintEmployee")
  linkMetrics        LinkMetric[]
  reportDrafts       ReportDraft[]
  metaConnections    MetaConnection[]        @relation("MetaConnectionsCreated")
  metaOauthStates    MetaOAuthState[]

  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  ONBOARDING
}

model Role {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id       String @id @default(uuid())
  roleId   String @map("role_id")
  resource String
  action   String
  scope    String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action, scope])
  @@map("role_permissions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ============ ORGANIZATION ============

model OrgUnit {
  id        String      @id @default(uuid())
  name      String
  type      OrgUnitType
  parentId  String?     @map("parent_id")
  leadId    String?     @map("lead_id")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  parent        OrgUnit?         @relation("OrgHierarchy", fields: [parentId], references: [id])
  children      OrgUnit[]        @relation("OrgHierarchy")
  // members = users whose PRIMARY team is this unit (back-relation of User.orgUnit).
  // memberships = the full multi-team join (a user appears here for every team they're in).
  members       User[]
  memberships   TeamMembership[]
  announcements Announcement[]

  @@map("org_units")
}

enum OrgUnitType {
  DEPARTMENT
  TEAM
  SUB_TEAM
}

// Join table enabling a user to belong to MULTIPLE teams (org units).
// User.orgUnitId remains the "primary" team for single-team read paths.
model TeamMembership {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  orgUnitId String   @map("org_unit_id")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgUnit OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)

  @@unique([userId, orgUnitId])
  @@index([orgUnitId])
  @@map("team_memberships")
}

// ============ ATTENDANCE ============

model Attendance {
  id            String           @id @default(uuid())
  employeeId    String           @map("employee_id")
  date          DateTime         @db.Date
  checkIn       DateTime?        @map("check_in")
  checkOut      DateTime?        @map("check_out")
  status        AttendanceStatus @default(PRESENT)
  overtimeHours Float            @default(0) @map("overtime_hours")
  ipAddress     String?          @map("ip_address")
  note          String?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  employee User @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@map("attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

model LeaveRequest {
  id             String      @id @default(uuid())
  employeeId     String      @map("employee_id")
  startDate      DateTime    @map("start_date") @db.Date
  endDate        DateTime    @map("end_date") @db.Date
  type           LeaveType
  reason         String
  status         LeaveStatus @default(PENDING)
  approvedBy     String?     @map("approved_by")
  approvedAt     DateTime?   @map("approved_at")
  attachmentUrl  String?     @map("attachment_url")
  attachmentName String?     @map("attachment_name")
  attachmentMime String?     @map("attachment_mime")
  attachmentSize Int?        @map("attachment_size")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  employee User  @relation("LeaveRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  approver User? @relation("LeaveApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@map("leave_requests")
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  UNPAID
  WFH
  COMP_OFF
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============ SETTINGS ============

model Setting {
  id        String   @id @default(uuid())
  namespace String
  key       String
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([namespace, key])
  @@map("settings")
}

// ============ AUDIT ============

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

// ============ PLATFORMS & SOCIAL ACCOUNTS ============

model Platform {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  iconUrl   String?  @map("icon_url")
  createdAt DateTime @default(now()) @map("created_at")

  accounts SocialAccount[]

  @@map("platforms")
}

model SocialAccount {
  id            String        @id @default(uuid())
  handle        String
  displayName   String        @map("display_name")
  platformId    String        @map("platform_id")
  clientName    String?       @map("client_name")
  status        AccountStatus @default(ACTIVE)
  profileUrl    String?       @map("profile_url")
  followerCount Int           @default(0) @map("follower_count")
  lastSyncedAt  DateTime?     @map("last_synced_at")
  metaAssets    MetaAsset[]
  /// HOW the current followerCount was obtained: "api" (official platform API —
  /// Meta Graph / YouTube Data API), "scraper" (public-page parse), or null =
  /// never auto-synced (hand-entered). Distinct from lastSyncedAt, which only
  /// says WHEN. A scraper number can be fresh yet less trustworthy than an API
  /// one, so freshness and provenance are shown as separate pills in the UI.
  syncSource    String?       @map("sync_source")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  platform        Platform                @relation(fields: [platformId], references: [id])
  assignments     AccountAssignment[]
  tasks           Task[]
  projectAccounts ProjectAccount[]
  contentPosts    ContentPost[]
  reportLinks     ReportLink[]
  growthSnapshots AccountGrowthSnapshot[]

  @@unique([handle, platformId])
  @@map("social_accounts")
}

enum AccountStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model AccountAssignment {
  id           String    @id @default(uuid())
  accountId    String    @map("account_id")
  employeeId   String    @map("employee_id")
  assignedBy   String    @map("assigned_by")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")
  reason       String?

  account  SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee User          @relation("AccountAssignee", fields: [employeeId], references: [id], onDelete: Cascade)
  assigner User          @relation("AccountAssigner", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([employeeId])
  @@map("account_assignments")
}

// ============ TASKS ============

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?      @map("assignee_id")
  createdById String       @map("created_by_id")
  accountId   String?      @map("account_id")
  dueDate     DateTime?    @map("due_date")
  completedAt DateTime?    @map("completed_at")
  dependsOnId String?      @map("depends_on_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  assignee     User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User           @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  account      SocialAccount? @relation(fields: [accountId], references: [id])
  dependsOn    Task?          @relation("TaskDependency", fields: [dependsOnId], references: [id])
  dependedOnBy Task[]         @relation("TaskDependency")
  comments     TaskComment[]
  projectTasks ProjectTask[]

  @@index([assigneeId])
  @@index([status])
  @@index([accountId])
  @@map("tasks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_comments")
}

// ============ CLIENTS ============

model Client {
  id           String       @id @default(uuid())
  companyName  String       @map("company_name")
  contactName  String       @map("contact_name")
  email        String       @unique
  passwordHash String       @map("password_hash")
  phone        String?
  logoUrl      String?      @map("logo_url")
  status       ClientStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  projects      Project[]
  refreshTokens ClientRefreshToken[]
  otpTokens     OtpToken[]

  @@map("clients")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ONBOARDING
}

model ClientInvite {
  id        String    @id @default(uuid())
  email     String    @unique
  token     String    @unique @default(uuid())
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now())

  @@map("client_invites")
}

model AdminInvite {
  id          String    @id @default(uuid())
  email       String    @unique
  token       String    @unique @default(uuid())
  roleIds     String[]  @map("role_ids")
  designation String?
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("admin_invites")
}

model ClientRefreshToken {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_refresh_tokens")
}

// ============ PROJECTS ============

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  clientId    String        @map("client_id")
  status      ProjectStatus @default(ACTIVE)
  healthScore Int?          @map("health_score")
  startDate   DateTime?     @map("start_date") @db.Date
  endDate     DateTime?     @map("end_date") @db.Date
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  client       Client           @relation(fields: [clientId], references: [id])
  accounts     ProjectAccount[]
  tasks        ProjectTask[]
  files        ProjectFile[]
  approvals    Approval[]
  contentPosts ContentPost[]

  @@index([clientId])
  @@map("projects")
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model ProjectAccount {
  id        String @id @default(uuid())
  projectId String @map("project_id")
  accountId String @map("account_id")

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  account SocialAccount @relation(fields: [accountId], references: [id])

  @@unique([projectId, accountId])
  @@map("project_accounts")
}

model ProjectTask {
  id        String @id @default(uuid())
  projectId String @map("project_id")
  taskId    String @map("task_id")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id])

  @@unique([projectId, taskId])
  @@map("project_tasks")
}

model ProjectFile {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  name         String
  url          String
  size         Int      @default(0)
  mimeType     String?  @map("mime_type")
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("FileUploader", fields: [uploadedById], references: [id])

  @@index([projectId])
  @@map("project_files")
}

model Approval {
  id            String         @id @default(uuid())
  projectId     String         @map("project_id")
  title         String
  description   String?
  fileUrl       String?        @map("file_url")
  status        ApprovalStatus @default(PENDING)
  requestedById String         @map("requested_by_id")
  respondedAt   DateTime?      @map("responded_at")
  clientNote    String?        @map("client_note")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("ApprovalRequester", fields: [requestedById], references: [id])

  @@index([projectId])
  @@index([status])
  @@map("approvals")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

// ============ CONTENT ============

model ContentPost {
  id          String        @id @default(uuid())
  title       String
  caption     String?       @db.Text
  mediaUrls   String[]      @map("media_urls")
  projectId   String        @map("project_id")
  accountId   String?       @map("account_id")
  status      ContentStatus @default(DRAFT)
  format      String?
  aspectRatio String?       @map("aspect_ratio")
  hashtags    String[]      @default([])
  scheduledAt DateTime?     @map("scheduled_at")
  publishedAt DateTime?     @map("published_at")
  createdById String        @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  project   Project        @relation(fields: [projectId], references: [id])
  account   SocialAccount? @relation(fields: [accountId], references: [id])
  createdBy User           @relation("ContentCreator", fields: [createdById], references: [id])
  comments  PostComment[]

  @@index([projectId])
  @@index([accountId])
  @@index([status])
  @@index([scheduledAt])
  @@map("content_posts")
}

enum ContentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
  REJECTED
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  body      String   @db.Text
  createdAt DateTime @default(now())

  post   ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User        @relation("PostCommentAuthor", fields: [authorId], references: [id])

  @@map("post_comments")
}

// ============ EMPLOYEE PROFILE ============

model EmployeeProfile {
  id                     String    @id @default(uuid())
  userId                 String    @unique @map("user_id")
  designation            String?
  jobDescription         String?   @map("job_description") @db.Text
  salary                 Float?
  bankAccountHolderName  String?   @map("bank_account_holder_name")
  bankAccountNumber      String?   @map("bank_account_number")
  bankName               String?   @map("bank_name")
  bankBranch             String?   @map("bank_branch")
  ifscCode               String?   @map("ifsc_code")
  mailingAddress         String?   @map("mailing_address") @db.Text
  aadhaarNumber          String?   @map("aadhaar_number")
  panNumber              String?   @map("pan_number")
  familyContact1Name     String?   @map("family_contact1_name")
  familyContact1Phone    String?   @map("family_contact1_phone")
  familyContact1Relation String?   @map("family_contact1_relation")
  familyContact2Name     String?   @map("family_contact2_name")
  familyContact2Phone    String?   @map("family_contact2_phone")
  familyContact2Relation String?   @map("family_contact2_relation")
  joiningDate            DateTime? @map("joining_date") @db.Date
  joiningDateApproved    Boolean   @default(false) @map("joining_date_approved")
  sopAcceptedAt          DateTime? @map("sop_accepted_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employee_profiles")
}

// ============ HR PORTAL ============

model OtpToken {
  id        String     @id @default(uuid())
  userId    String?    @map("user_id")
  clientId  String?    @map("client_id")
  otp       String
  channel   OtpChannel
  target    String
  expiresAt DateTime   @map("expires_at")
  verified  Boolean    @default(false)
  createdAt DateTime   @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId, otp])
  @@index([clientId, otp])
  @@index([expiresAt])
  @@map("otp_tokens")
}

enum OtpChannel {
  EMAIL
  SMS
  WHATSAPP
}

model DailyReport {
  id            String   @id @default(uuid())
  employeeId    String   @map("employee_id")
  date          DateTime @db.Date
  notes         String?  @db.Text
  latitude      Float?
  longitude     Float?
  submittedFrom String?  @map("submitted_from")
  submittedAt   DateTime @default(now()) @map("submitted_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  employee User         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  links    ReportLink[]

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@map("daily_reports")
}

model ReportLink {
  id           String    @id @default(uuid())
  reportId     String    @map("report_id")
  accountId    String    @map("account_id")
  url          String?
  platform     String
  description  String?
  mediaUrl     String?   @map("media_url")
  likes        Int?
  comments     Int?
  shares       Int?
  views        Int?
  isScheduled  Boolean   @default(false) @map("is_scheduled")
  scheduledFor DateTime? @map("scheduled_for")
  createdAt    DateTime  @default(now()) @map("created_at")
  // When this exact URL was FIRST submitted within its report's day. Unlike
  // createdAt (which is rewritten on every resubmit because submission uses
  // delete-and-recreate), firstSeenAt is preserved per-URL across edits — see
  // submitDailyReport(). This is the only trustworthy "when was it posted" time.
  // Historical rows are backfilled to createdAt (best available proxy).
  firstSeenAt  DateTime  @default(now()) @map("first_seen_at")

  report  DailyReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  account SocialAccount @relation(fields: [accountId], references: [id])
  metrics LinkMetric[]

  @@index([reportId])
  @@index([accountId])
  @@index([url])
  @@index([firstSeenAt])
  @@map("report_links")
}

model AccountGrowthSnapshot {
  id             String   @id @default(uuid())
  accountId      String   @map("account_id")
  date           DateTime @db.Date
  followerCount  Int      @map("follower_count")
  followingCount Int?     @map("following_count")
  postCount      Int?     @map("post_count")
  engagementRate Float?   @map("engagement_rate")
  createdAt      DateTime @default(now()) @map("created_at")

  /// Provenance of THIS snapshot's followerCount:
  ///   "meta_oauth"  — a connected meta_assets row (the ONLY accepted Meta source)
  ///   "youtube_api" — YouTube Data API
  ///   "scraper"     — Snapchat / X public-page parse, or the retired pre-2026-08 Meta scrapers
  ///   "manual"      — hand-entered / xlsx import
  ///   NULL          — written before this column existed; not classifiable
  ///
  /// ⚠️ LOAD-BEARING: for platform.slug IN ('instagram','facebook') the growth service
  /// reads ONLY source='meta_oauth' rows. Without this, the per-account follower chart
  /// splices pre-cutover SCRAPER points onto post-cutover OAUTH points and the step
  /// change between two different measurement systems RENDERS AS GROWTH. The existing
  /// isFollowerCorrectionArtifact(±90%/+200%) guard only catches extremes — a real
  /// 4.2m→4.6m correction sails straight through it.
  source String? @map("source")

  account SocialAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, date])
  @@index([accountId, source, date])
  @@index([accountId, date])
  @@map("account_growth_snapshots")
}

