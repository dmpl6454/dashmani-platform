DATABASE_URL=postgresql://user:password@localhost:5432/dashmani

# Required for db:seed — set a strong password, never commit the actual value
SEED_ADMIN_PASSWORD=
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-refresh
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
PORT=4000

# SMTP — required for announcement emails, invite emails, and HR notifications
# Use a Gmail App Password (not your account password): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-app-password

# App URLs — used in email links
INTERNAL_APP_URL=http://localhost:3000
HR_APP_URL=http://localhost:3002
