# ============================================================
# Dashmani Platform — environment template
# Copy this file to .env (root), apps/api/.env, AND packages/db/.env
# All three locations must have the same DATABASE_URL / JWT secrets
# ============================================================

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL=postgresql://user:password@localhost:5432/dashmani

# --- Redis (matches docker-compose.yml defaults) ---
REDIS_URL=redis://localhost:6379

# --- JWT (change in production — use long random strings) ---
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-refresh

# --- API ---
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# --- Seeding (required for npm run db:seed — never commit actual value) ---
SEED_ADMIN_PASSWORD=Admin@123456

# --- App URLs (used in reset-password and notification emails) ---
INTERNAL_APP_URL=http://localhost:3000
HR_APP_URL=http://localhost:3002

# --- SMTP (optional — emails silently no-op if missing) ---
# Use a Gmail App Password: Google Account → Security → App Passwords (needs 2FA)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hr@digitalsukoon.com
SMTP_PASS=your-gmail-app-password
# Inbox that receives campaign enquiries from the digitalsukoon.com contact form
SITE_ENQUIRY_TO=hello@digitalsukoon.com

# --- Campaign booking (client portal "Campaigns") ---
# Payment mode. Without Razorpay keys (or with CAMPAIGN_PAYMENT_MODE=offline) checkout runs
# "offline": the booking is submitted for review with no online payment and the amount is
# collected by hand. Set the keys (and unset the override) to switch to Razorpay — no deploy.
# Webhook: https://api.digitalsukoon.com/v1/webhooks/razorpay
CAMPAIGN_PAYMENT_MODE=offline
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Private media folder (never under uploads/). Prod: /var/lib/dashmani/campaign-media
CAMPAIGN_MEDIA_DIR=
# Optional knobs: CAMPAIGN_MIN_FREE_GB=5  CAMPAIGN_CLIENT_QUOTA_GB=2  CAMPAIGN_RETENTION_DAYS=14
#                 CAMPAIGN_RENDER_ENABLED=1  CAMPAIGN_TEAM_EMAIL=hello@digitalsukoon.com
# Phase 2 auto-publish through the Meta API — OFF unless set to 1.
CAMPAIGN_PUBLISH_ENABLED=0
# Public origin Meta downloads the media from (signed links). CAMPAIGN_PUBLISH_HOUR_IST=10
API_PUBLIC_URL=https://api.digitalsukoon.com
CLIENT_APP_URL=http://localhost:3001

# --- "Sign in with Google" on the client portal ---
# A Google Cloud OAuth client id of type "Web application" whose Authorized JavaScript
# origins include the portal (https://client.digitalsukoon.com, http://localhost:3001 locally).
# No secret is needed: the browser's Google button yields an ID token the API verifies with
# Google. Runtime-only (served to the portal by GET /v1/client/auth/google/config) — set it in
# apps/api/.env and `pm2 restart api`; blank hides the button.
GOOGLE_CLIENT_ID=
